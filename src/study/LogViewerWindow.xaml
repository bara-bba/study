<Window x:Class="Study.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="study — Log viewer"
        Height="640" Width="1100" MinHeight="400" MinWidth="760"
        Background="{StaticResource Brush.App}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid Margin="20,10,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Height="44">
            <TextBlock Text="Log viewer" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="—" Click="Minimize_Click" Style="{StaticResource IconButton}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" />
                <Button Content="▢" Click="Maximize_Click" Style="{StaticResource IconButton}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize" />
                <Button Content="✕" Click="Close_Click" Style="{StaticResource IconButton}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" />
            </StackPanel>
        </Grid>

        <!-- Folder bar -->
        <Grid Grid.Row="1" Margin="0,8,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Folder" Foreground="{StaticResource Brush.TextSecondary}" FontSize="13" VerticalAlignment="Center" Margin="2,0,12,0" />
            <Border Grid.Column="1" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Stroke}"
                    BorderThickness="1" CornerRadius="4" Padding="10,0" Height="34">
                <TextBlock Name="FolderText" Foreground="{StaticResource Brush.TextTertiary}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Border>
            <Button Grid.Column="2" Content="✎" Click="ChangeFolder_Click" Style="{StaticResource ToolIconButton}" Margin="8,0,0,0"
                    ToolTip="Change log folder…" />
            <Button Grid.Column="3" Content="⧉" Click="OpenFolder_Click" Style="{StaticResource ToolIconButton}" Margin="8,0,0,0"
                    ToolTip="Open log folder in Explorer" />
            <Button Grid.Column="4" Content="⟳" FontSize="18" Click="Refresh_Click" Style="{StaticResource ToolIconButton}" Margin="8,0,0,0"
                    ToolTip="Refresh" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- File list -->
            <DockPanel Margin="0,0,16,0">
                <TextBlock DockPanel.Dock="Top" Text="Files (Ctrl+click: several days)" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" />
                <ListBox Name="FileList" Style="{StaticResource DarkList}" SelectionMode="Extended"
                         SelectionChanged="FileList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="12" />
                                <TextBlock Text="{Binding Info}" FontSize="11" Foreground="{StaticResource Brush.TextTertiary}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Entries -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Search" Foreground="{StaticResource Brush.TextSecondary}" FontSize="13"
                               VerticalAlignment="Center" Margin="2,0,10,0" />
                    <TextBox Grid.Column="1" Name="SearchBox" Style="{StaticResource DarkTextBox}" TextChanged="Filter_Changed"
                             ToolTip="Search watch, PLC, IP, tag, value or detail" />
                    <ComboBox Grid.Column="2" Name="EventCombo" Style="{StaticResource DarkCombo}" Margin="8,0,0,0"
                              SelectionChanged="Filter_Changed" />
                    <CheckBox Grid.Column="3" Name="AutoRefreshCheck" Content="Live" Style="{StaticResource DarkCheckBox}"
                              Margin="12,0,0,0" IsChecked="True" ToolTip="Re-read the selected files every 3 seconds" />
                </Grid>

                <DataGrid Grid.Row="1" Name="EntryGrid" Style="{StaticResource DarkGrid}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DarkGridRow}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Event}" Value="TRIGGER">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Bad}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Event}" Value="ACK">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Ok}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Event}" Value="UNREACHABLE">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Warn}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Event}" Value="READ_ERROR">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Warn}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss.fff}" Width="160" />
                        <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="100" />
                        <DataGridTextColumn Header="Watch" Binding="{Binding Watch}" Width="1.2*" MinWidth="110" />
                        <DataGridTextColumn Header="PLC" Binding="{Binding Plc}" Width="90" />
                        <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="100" />
                        <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="1.2*" MinWidth="110" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="66" />
                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="1.6*" MinWidth="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3" Name="StatusText" Style="{StaticResource Hint}" Margin="2,10,0,0" />
    </Grid>
</Window>
