<Window x:Class="Study.WatchEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="study — Watch"
        Width="580" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource Brush.App}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <StackPanel Margin="22,16,22,18">
        <Grid>
            <TextBlock Name="HeaderText" Text="New watch" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="✕" Click="Cancel_Click" Style="{StaticResource IconButton}" HorizontalAlignment="Right" />
        </Grid>
        <TextBlock Text="Monitor a tag, optionally combined with other tags (AND / OR / XOR), and sound the alarm when the trigger fires. Read-only — study never writes to the PLC."
                   Style="{StaticResource Hint}" Margin="0,4,0,12" />

        <!-- Tabs -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
            <RadioButton Name="BasicTab" Content="Basic" GroupName="EditorTabs" Style="{StaticResource PivotTab}"
                         IsChecked="True" Checked="Tab_Checked" />
            <RadioButton Name="AdvancedTab" Content="Advanced" GroupName="EditorTabs" Style="{StaticResource PivotTab}"
                         Checked="Tab_Checked" ToolTip="Extra tags, AND / OR / XOR logic, custom formula, alarm behaviour" />
        </StackPanel>
        <Border Height="1" Background="{StaticResource Brush.Stroke}" Margin="0,0,0,4" />

        <!-- ============================================================ BASIC -->
        <StackPanel Name="BasicPanel">
            <!-- Name -->
            <TextBlock Text="Name (optional — shown in the list and on the alarm)" Style="{StaticResource Label}" />
            <TextBox Name="NameBox" Style="{StaticResource DarkTextBox}" />

            <!-- PLC -->
            <TextBlock Text="PLC" Style="{StaticResource Label}" Margin="2,14,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Search" Foreground="{StaticResource Brush.TextSecondary}" FontSize="13"
                           VerticalAlignment="Center" Margin="2,0,10,0" />
                <TextBox Grid.Column="1" Name="PlcFilterBox" Style="{StaticResource DarkTextBox}" TextChanged="PlcFilter_Changed"
                         ToolTip="Filter the PLC list by name, IP or folder" Margin="0,0,8,0" />
                <!-- ItemTemplate (not DisplayMemberPath): the DarkCombo selection box renders via the template. -->
                <ComboBox Grid.Column="2" Name="PlcCombo" Style="{StaticResource DarkCombo}"
                          SelectionChanged="PlcCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding GroupLabel}" FontSize="11" Opacity="0.6"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <TextBlock Name="PlcHint" Style="{StaticResource Hint}" />

            <!-- Tag + type -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tag" Style="{StaticResource Label}" />
                    <TextBox Name="TagBox" Style="{StaticResource DarkTextBox}" FontFamily="Cascadia Mono, Consolas"
                             TextChanged="Any_Changed" />
                </StackPanel>
                <Button Grid.Column="1" Content="Browse…" Click="Browse_Click" Style="{StaticResource SubtleButton}"
                        Height="32" Padding="14,0" VerticalAlignment="Bottom" Margin="8,0,8,0" ToolTip="List the tags in the PLC" />
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Data type" Style="{StaticResource Label}" />
                    <ComboBox Name="TypeCombo" Style="{StaticResource DarkCombo}" SelectionChanged="Any_Changed" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Examples: Estop_Active · Program:MainProgram.Fault · StatusWord.5 (bit 5 of a DINT, use BOOL) · Local:1:I.Data.3" />

            <!-- Trigger -->
            <TextBlock Text="Trigger — when should the alarm sound?" Style="{StaticResource Label}" Margin="2,14,0,6" />
            <ComboBox Name="ModeCombo" Style="{StaticResource DarkCombo}" SelectionChanged="Any_Changed">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Name="ModeHint" Style="{StaticResource Hint}" />

            <StackPanel Name="ExpressionPanel" Margin="0,10,0,0">
                <TextBlock Text="Expression" Style="{StaticResource Label}" />
                <TextBox Name="ExpressionBox" Style="{StaticResource DarkTextBox}" FontFamily="Cascadia Mono, Consolas"
                         TextChanged="Any_Changed" />
                <TextBlock Name="ExpressionStatus" Style="{StaticResource Hint}" />
                <TextBlock Style="{StaticResource Hint}" Text="x = current value, prev = previous value (BOOL = 1/0).&#x0a;Operators: + - * / %   == != &lt; &lt;= &gt; &gt;=   &amp;&amp; || !  (or: and, or, not)&#x0a;Functions: abs(a) · min(a,b) · max(a,b) · bit(a,n)&#x0a;Examples: x &gt; 100  ·  x &gt;= 10 &amp;&amp; x &lt;= 20  ·  prev &lt; 100 &amp;&amp; x &gt;= 100  ·  abs(x - prev) &gt; 5  ·  bit(x, 3)" />
            </StackPanel>

            <!-- Polling -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Polling time (ms)" Foreground="{StaticResource Brush.TextSecondary}" FontSize="13"
                           VerticalAlignment="Center" Margin="2,0,12,0" />
                <TextBox Grid.Column="1" Name="PollBox" Style="{StaticResource DarkTextBox}" />
                <TextBlock Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="100 ms – 3600 s. 1000 = once a second." />
            </Grid>

            <CheckBox Name="EnabledCheck" Style="{StaticResource DarkCheckBox}" Margin="0,14,0,0" Content="Enabled" IsChecked="True" />

            <!-- Summary of the Advanced tab -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Extra conditions" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Name="SummaryText" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="GoAdvanced_Click" Style="{StaticResource SubtleButton}"
                            Margin="12,0,0,0" ToolTip="Add tags and choose AND / OR / XOR or a custom formula">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Advanced" VerticalAlignment="Center" />
                            <Path Data="M 0.5,0.5 L 4,4 L 0.5,7.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center" Margin="9,1,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ========================================================= ADVANCED -->
        <StackPanel Name="AdvancedPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,10"
                       Text="Every condition has a letter. A is the main tag from the Basic tab; B, C, … are extra tags on the same PLC, read on every poll." />

            <!-- A: main trigger (read-only here) -->
            <TextBlock Text="Conditions" Style="{StaticResource Label}" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,10,10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Top + 3 px: centred on a 32 px line, the same as the B, C… badges next to their tag box. -->
                    <Border Style="{StaticResource LetterBadge}" Margin="0,3,10,0" VerticalAlignment="Top"
                            Background="{DynamicResource Brush.Accent}"
                            BorderBrush="{DynamicResource Brush.Accent}">
                        <TextBlock Text="A" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Name="MainTagText" FontFamily="Cascadia Mono, Consolas" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Image Name="MainModeIcon" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Name="MainModeText" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Content="✎" Click="GoBasic_Click" Style="{StaticResource ToolIconButton}"
                            ToolTip="Change the main tag and trigger (Basic tab)" />
                </Grid>
            </Border>
            <StackPanel Name="ConditionPanel" />
            <Button Name="AddConditionButton" Content="＋  Add condition" Click="AddCondition_Click" Style="{StaticResource SubtleButton}"
                    HorizontalAlignment="Left" Height="32" Padding="14,0"
                    ToolTip="Add another tag on the same PLC (TRUE / FALSE / expression)" />

            <!-- Combine -->
            <TextBlock Text="How the conditions combine" Style="{StaticResource Label}" Margin="2,16,0,6" />
            <ComboBox Name="CombineCombo" Style="{StaticResource DarkCombo}" SelectionChanged="Combine_Changed" />

            <StackPanel Name="FormulaPanel" Margin="0,10,0,0">
                <TextBlock Text="Formula" Style="{StaticResource Label}" />
                <TextBox Name="FormulaBox" Style="{StaticResource DarkTextBox}" FontFamily="Cascadia Mono, Consolas"
                         TextChanged="Formula_Changed" />
                <TextBlock Name="FormulaStatus" Style="{StaticResource Hint}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Letters A–Z · and (&amp;&amp;)  ·  or (||)  ·  xor (^)  ·  not (!)  ·  ( )&#x0a;Order: NOT first, then AND, then XOR, then OR — use brackets when in doubt.&#x0a;Examples: A and not B  ·  A and (B or C)  ·  (A xor B) and C  ·  A or B or C" />
            </StackPanel>

            <!-- Result -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Alarm when" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" />
                    <TextBlock Name="ResultFormula" FontFamily="Cascadia Mono, Consolas" FontSize="15" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Name="ResultWords" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Name="TruthLabel" Text="Every combination (✓ = alarm)" FontSize="12"
                               Foreground="{StaticResource Brush.TextSecondary}" Margin="0,10,0,4" />
                    <Grid Name="TruthGrid" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Behaviour -->
            <TextBlock Text="Alarm behaviour" Style="{StaticResource Label}" Margin="2,16,0,6" />
            <CheckBox Name="StopWhenClearedCheck" Style="{StaticResource DarkCheckBox}"
                      Content="Stop the alarm automatically when the condition clears" />
            <TextBlock Name="BehaviourHint" Style="{StaticResource Hint}" />
        </StackPanel>

        <!-- ============================================================ SHARED -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Name="TestResult" Text="Test read: ping the PLC and read every tag once, without saving."
                           Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Name="TestButton" Content="▶  Test read" Click="Test_Click"
                        Style="{StaticResource SubtleButton}" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <TextBlock Name="ErrorText" Style="{StaticResource ErrorLine}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SubtleButton}" Margin="0,0,8,0" />
            <Button Content="Save" Click="Save_Click" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
