<Window x:Class="Study.WatchEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="study — Watch"
        Width="520" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource Brush.App}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <StackPanel Margin="22,16,22,18">
        <Grid>
            <TextBlock Name="HeaderText" Text="New watch" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="✕" Click="Cancel_Click" Style="{StaticResource IconButton}" HorizontalAlignment="Right" />
        </Grid>
        <TextBlock Text="Monitor one tag and sound the alarm when the trigger fires. Read-only — study never writes to the PLC."
                   Style="{StaticResource Hint}" Margin="0,4,0,16" />

        <!-- Name -->
        <TextBlock Text="Name (optional — shown in the list and on the alarm)" Style="{StaticResource Label}" />
        <TextBox Name="NameBox" Style="{StaticResource DarkTextBox}" />

        <!-- PLC -->
        <TextBlock Text="PLC" Style="{StaticResource Label}" Margin="2,14,0,6" />
        <!-- ItemTemplate (not DisplayMemberPath): the DarkCombo selection box renders via the template. -->
        <ComboBox Name="PlcCombo" Style="{StaticResource DarkCombo}"
                  SelectionChanged="PlcCombo_SelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding GroupLabel}" FontSize="11" Opacity="0.6"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Name="PlcHint" Style="{StaticResource Hint}" />

        <!-- Tag + type -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Tag" Style="{StaticResource Label}" />
                <TextBox Name="TagBox" Style="{StaticResource DarkTextBox}" FontFamily="Cascadia Mono, Consolas" />
            </StackPanel>
            <Button Grid.Column="1" Content="Browse…" Click="Browse_Click" Style="{StaticResource SubtleButton}"
                    Height="32" Padding="14,0" VerticalAlignment="Bottom" Margin="8,0,8,0" ToolTip="List the tags in the PLC" />
            <StackPanel Grid.Column="2">
                <TextBlock Text="Data type" Style="{StaticResource Label}" />
                <ComboBox Name="TypeCombo" Style="{StaticResource DarkCombo}" SelectionChanged="Any_Changed" />
            </StackPanel>
        </Grid>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Examples: Estop_Active · Program:MainProgram.Fault · StatusWord.5 (bit 5 of a DINT, use BOOL) · Local:1:I.Data.3" />

        <!-- Trigger -->
        <TextBlock Text="Trigger — when should the alarm sound?" Style="{StaticResource Label}" Margin="2,14,0,6" />
        <ComboBox Name="ModeCombo" Style="{StaticResource DarkCombo}" SelectionChanged="Any_Changed">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Name="ModeHint" Style="{StaticResource Hint}" />

        <StackPanel Name="ExpressionPanel" Margin="0,10,0,0">
            <TextBlock Text="Expression" Style="{StaticResource Label}" />
            <TextBox Name="ExpressionBox" Style="{StaticResource DarkTextBox}" FontFamily="Cascadia Mono, Consolas"
                     TextChanged="Any_Changed" />
            <TextBlock Name="ExpressionStatus" Style="{StaticResource Hint}" />
            <TextBlock Style="{StaticResource Hint}" Text="x = current value, prev = previous value (BOOL = 1/0).&#x0a;Operators: + - * / %   == != &lt; &lt;= &gt; &gt;=   &amp;&amp; || !  (or: and, or, not)&#x0a;Functions: abs(a) · min(a,b) · max(a,b) · bit(a,n)&#x0a;Examples: x &gt; 100  ·  x &gt;= 10 &amp;&amp; x &lt;= 20  ·  prev &lt; 100 &amp;&amp; x &gt;= 100  ·  abs(x - prev) &gt; 5  ·  bit(x, 3)" />
        </StackPanel>

        <CheckBox Name="StopWhenClearedCheck" Style="{StaticResource DarkCheckBox}" Margin="0,12,0,0"
                  Content="Stop the alarm automatically when the condition clears" />

        <!-- Polling -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Polling time (ms)" Foreground="{StaticResource Brush.TextSecondary}" FontSize="13"
                       VerticalAlignment="Center" Margin="2,0,12,0" />
            <TextBox Grid.Column="1" Name="PollBox" Style="{StaticResource DarkTextBox}" />
            <TextBlock Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Text="100 ms – 3600 s. 1000 = once a second." />
        </Grid>

        <CheckBox Name="EnabledCheck" Style="{StaticResource DarkCheckBox}" Margin="0,14,0,0" Content="Enabled" IsChecked="True" />

        <!-- Test read -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Name="TestResult" Text="Test read: ping the PLC and read the tag once, without saving."
                           Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Name="TestButton" Content="▶  Test read" Click="Test_Click"
                        Style="{StaticResource SubtleButton}" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <TextBlock Name="ErrorText" Style="{StaticResource ErrorLine}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SubtleButton}" Margin="0,0,8,0" />
            <Button Content="Save" Click="Save_Click" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
