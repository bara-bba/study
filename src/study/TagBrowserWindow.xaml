<Window x:Class="Study.TagBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="study — Browse tags"
        Width="560" Height="600"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource Brush.App}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid Margin="22,16,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="Browse tags" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="✕" Click="Cancel_Click" Style="{StaticResource IconButton}" HorizontalAlignment="Right" />
        </Grid>
        <TextBlock Grid.Row="1" Name="ScopeText" Style="{StaticResource Hint}" Margin="0,4,0,12" />

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Name="BackButton" Content="← Controller" Click="Back_Click" Style="{StaticResource SubtleButton}"
                    Margin="0,0,8,0" Visibility="Collapsed" />
            <TextBox Grid.Column="1" Name="FilterBox" Style="{StaticResource DarkTextBox}" TextChanged="Filter_Changed"
                     ToolTip="Filter by name" />
        </Grid>

        <ListBox Grid.Row="3" Name="TagList" Style="{StaticResource DarkList}"
                 MouseDoubleClick="TagList_MouseDoubleClick" SelectionChanged="TagList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding TypeLabel}" Foreground="{StaticResource Brush.TextTertiary}"
                                   FontSize="11" Margin="12,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="4" Name="StatusText" Style="{StaticResource Hint}" Margin="2,8,0,0"
                   Text="Double-click a PROGRAM to see its tags. Double-click a tag to pick it." />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SubtleButton}" Margin="0,0,8,0" />
            <Button Name="PickButton" Content="Use tag" Click="Pick_Click" Style="{StaticResource AccentButton}" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
