<Window x:Class="Study.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="study — Settings"
        Width="500" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource Brush.App}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <StackPanel Margin="22,16,22,18">
        <Grid>
            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="✕" Click="Cancel_Click" Style="{StaticResource IconButton}" HorizontalAlignment="Right" />
        </Grid>
        <TextBlock Name="ConfigPathText" Style="{StaticResource Hint}" Margin="0,4,0,16" />

        <!-- Alarm sound -->
        <TextBlock Text="ALARM SOUND" Foreground="{StaticResource Brush.TextTertiary}" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Name="SoundCombo" Style="{StaticResource DarkCombo}" SelectionChanged="SoundCombo_SelectionChanged" />
            <Button Grid.Column="1" Content="▶  Test" Click="TestSound_Click" Style="{StaticResource SubtleButton}" Margin="8,0,0,0"
                    Height="32" Padding="14,0" ToolTip="Play the selected sound at the chosen volume" />
            <Button Grid.Column="2" Content="⏹  Stop" Click="StopSound_Click" Style="{StaticResource SubtleButton}" Margin="8,0,0,0"
                    Height="32" Padding="14,0" />
        </Grid>
        <Grid Name="CustomPanel" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1"
                    CornerRadius="4" Padding="10,0" Height="34">
                <TextBlock Name="CustomPathText" Foreground="{StaticResource Brush.TextTertiary}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Border>
            <Button Grid.Column="1" Content="Choose file…" Click="ChooseSound_Click" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" />
        </Grid>
        <TextBlock Style="{StaticResource Hint}" Text="One sound for every alarm. It loops until you press Acknowledge (or the auto-stop time below)." />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Volume" Foreground="{StaticResource Brush.TextSecondary}" FontSize="13" VerticalAlignment="Center" Margin="2,0,0,0" />
            <Slider Grid.Column="1" Name="VolumeSlider" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="100"
                    VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
            <TextBlock Grid.Column="2" Name="VolumeText" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Auto-stop sound after (s)" Foreground="{StaticResource Brush.TextSecondary}" FontSize="13"
                       VerticalAlignment="Center" Margin="2,0,12,0" />
            <TextBox Grid.Column="1" Name="AutoStopBox" Style="{StaticResource DarkTextBox}" />
            <TextBlock Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Text="0 = keep ringing until acknowledged" />
        </Grid>

        <Border Height="1" Background="{StaticResource Brush.Stroke}" Margin="0,18,0,14" />

        <!-- Monitoring -->
        <TextBlock Text="MONITORING" Foreground="{StaticResource Brush.TextTertiary}" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Default polling time (ms)" Foreground="{StaticResource Brush.TextSecondary}" FontSize="13"
                       VerticalAlignment="Center" Margin="2,0,12,0" />
            <TextBox Grid.Column="1" Name="PollBox" Style="{StaticResource DarkTextBox}" />
            <TextBlock Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Text="pre-filled for new watches" />
        </Grid>
        <CheckBox Name="SkipPingCheck" Style="{StaticResource DarkCheckBox}" Margin="0,12,0,0"
                  Content="Skip the ping check (use when ICMP is blocked but EtherNet/IP works)" />
        <CheckBox Name="CommAlarmCheck" Style="{StaticResource DarkCheckBox}" Margin="0,10,0,0"
                  Content="Also sound the alarm when a connected PLC is lost" />
        <CheckBox Name="NotifyCheck" Style="{StaticResource DarkCheckBox}" Margin="0,10,0,0"
                  Content="Show a Windows notification when an alarm fires" />

        <Border Height="1" Background="{StaticResource Brush.Stroke}" Margin="0,18,0,14" />

        <!-- Log -->
        <TextBlock Text="LOG" Foreground="{StaticResource Brush.TextTertiary}" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1"
                    CornerRadius="4" Padding="10,0" Height="34">
                <TextBlock Name="LogFolderText" Foreground="{StaticResource Brush.TextTertiary}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Border>
            <Button Grid.Column="1" Content="✎" Click="ChooseLogFolder_Click" Style="{StaticResource ToolIconButton}" Margin="8,0,0,0"
                    ToolTip="Change log folder…" />
            <Button Grid.Column="2" Content="⧉" Click="OpenLogFolder_Click" Style="{StaticResource ToolIconButton}" Margin="8,0,0,0"
                    ToolTip="Open log folder in Explorer" />
        </Grid>
        <TextBlock Style="{StaticResource Hint}" Text="One CSV per day: study-YYYY-MM-DD.csv (opens in Excel, readable while study runs)." />

        <Border Height="1" Background="{StaticResource Brush.Stroke}" Margin="0,18,0,14" />

        <!-- Appearance / startup -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Accent color" Foreground="{StaticResource Brush.TextSecondary}" FontSize="13"
                       VerticalAlignment="Center" Margin="2,0,12,0" />
            <Border Grid.Column="1" Name="AccentSwatch" Width="24" Height="24" CornerRadius="4"
                    BorderBrush="{StaticResource Brush.TextTertiary}" BorderThickness="1" Margin="0,0,8,0" />
            <TextBox Grid.Column="2" Name="AccentBox" Style="{StaticResource DarkTextBox}" MaxLength="7" TextChanged="AccentBox_TextChanged" />
        </Grid>
        <CheckBox Name="StartWithWindowsCheck" Style="{StaticResource DarkCheckBox}" Margin="0,14,0,0" Content="Start with Windows" />

        <TextBlock Name="ErrorText" Style="{StaticResource ErrorLine}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SubtleButton}" Margin="0,0,8,0" />
            <Button Content="Save" Click="Save_Click" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
