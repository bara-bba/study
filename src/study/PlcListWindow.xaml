<Window x:Class="Study.PlcListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Study.ViewModels"
        Title="study — PLC list"
        Width="880" Height="740"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource Brush.App}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <!-- Folder row: chevron comes from the item template; name + PLC count. -->
        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNode}" ItemsSource="{Binding Children}"
                                  ItemContainerStyle="{StaticResource DarkTreeItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="🗀" FontSize="13" Foreground="{StaticResource Brush.TextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11"
                           Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center" />
            </Grid>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type vm:PlcNode}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Entry.Name}" TextTrimming="CharacterEllipsis" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Entry.Ip}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                           Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Entry.Slot, StringFormat=slot {0}}" FontSize="11"
                           Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding Entry.Source}" FontSize="11"
                           Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="22,16,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="PLC list" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="✕" Click="Cancel_Click" Style="{StaticResource IconButton}" HorizontalAlignment="Right" ToolTip="Close" />
        </Grid>
        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="0,4,0,12" TextTrimming="CharacterEllipsis"
                   Text="ControlLogix / CompactLogix controllers, in folders, A→Z. Imports merge by IP: names, slots and folders you set are kept." />

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="Import from RSLinx" Click="ImportRsLinx_Click" Style="{StaticResource SubtleButton}" Margin="0,0,8,0"
                        ToolTip="Reads the IPs configured in RSLinx Classic's Ethernet devices (AB_ETH) drivers" />
                <Button Content="Import…" Click="Import_Click" Style="{StaticResource SubtleButton}" Margin="0,0,8,0"
                        ToolTip="Merge a PLC list from a study JSON tree or a CSV (name,ip,slot,notes,group)" />
                <Button Content="Export…" Click="Export_Click" Style="{StaticResource SubtleButton}" Margin="0,0,8,0"
                        ToolTip="Save the list as a JSON tree or as CSV" />
                <Border Width="1" Background="{StaticResource Brush.Stroke}" Margin="2,2,10,2" />
                <Button Content="＋  Add PLC" Click="Add_Click" Style="{StaticResource SubtleButton}"
                        ToolTip="Add a PLC to the selected folder" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="⊞" FontSize="15" Click="ExpandAll_Click" Style="{StaticResource ToolIconButton}" Margin="0,0,8,0"
                        ToolTip="Expand all folders" />
                <Button Content="⊟" FontSize="15" Click="CollapseAll_Click" Style="{StaticResource ToolIconButton}" Margin="0,0,8,0"
                        ToolTip="Collapse all folders" />
                <Button Content="⧉" Click="OpenConfigFolder_Click" Style="{StaticResource ToolIconButton}"
                        ToolTip="Open the folder with plcs.json in Explorer" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Search" Foreground="{StaticResource Brush.TextSecondary}" FontSize="13"
                           VerticalAlignment="Center" Margin="2,0,10,0" />
                <TextBox Grid.Column="1" Name="FilterBox" Style="{StaticResource DarkTextBox}" TextChanged="Filter_Changed"
                         ToolTip="Filter by name, IP, folder or notes" />
            </Grid>

            <TreeView Grid.Row="1" Name="PlcTreeView" Style="{StaticResource DarkTree}" Margin="0,0,16,0"
                      SelectedItemChanged="PlcTreeView_SelectedItemChanged" />

            <!-- Right panel: PLC details or folder actions, depending on the selection -->
            <Border Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                    <StackPanel Name="DetailPanel" IsEnabled="False">
                        <TextBlock Text="Name" Style="{StaticResource Label}" />
                        <TextBox Name="NameBox" Style="{StaticResource DarkTextBox}" />
                        <TextBlock Text="IP address" Style="{StaticResource Label}" Margin="2,12,0,6" />
                        <TextBox Name="IpBox" Style="{StaticResource DarkTextBox}" FontFamily="Cascadia Mono, Consolas" />
                        <TextBlock Text="CPU slot" Style="{StaticResource Label}" Margin="2,12,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Name="SlotBox" Style="{StaticResource DarkTextBox}" />
                            <Button Grid.Column="1" Name="DetectButton" Content="Detect slot" Click="Detect_Click"
                                    Style="{StaticResource SubtleButton}" Height="32" Padding="14,0" Margin="8,0,0,0"
                                    ToolTip="Tries slots 0–16 until the CPU answers (read-only)" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="CompactLogix: always 0. ControlLogix: the slot the CPU card sits in." />
                        <TextBlock Text="Folder" Style="{StaticResource Label}" Margin="2,12,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Name="GroupBox" Style="{StaticResource DarkTextBox}" />
                            <Button Grid.Column="1" Name="PickGroupButton" Content="▾" Click="PickGroup_Click"
                                    Style="{StaticResource ToolIconButton}" Height="32" Margin="8,0,0,0"
                                    ToolTip="Pick an existing folder" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="Use / for sub-folders, e.g. Line 2/Stackers. Empty = top level." />
                        <TextBlock Text="Notes" Style="{StaticResource Label}" Margin="2,12,0,6" />
                        <TextBox Name="NotesBox" Style="{StaticResource DarkTextBox}" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Apply" Click="Apply_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,0" />
                            <Button Name="TestButton" Content="▶  Test" Click="Test_Click" Style="{StaticResource SubtleButton}" Margin="0,0,8,0"
                                    ToolTip="Ping the PLC and open a read-only connection" />
                            <Button Content="🗑" FontSize="14" Click="Delete_Click" Style="{StaticResource ToolIconButton}" ToolTip="Remove from list" />
                        </StackPanel>
                        <TextBlock Name="DetailStatus" Style="{StaticResource Hint}" Margin="2,10,0,0" />
                    </StackPanel>

                    <StackPanel Name="FolderPanel" Visibility="Collapsed">
                        <TextBlock Text="Folder" Style="{StaticResource Label}" />
                        <TextBox Name="FolderPathBox" Style="{StaticResource DarkTextBox}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Rename, or move it with a path: Site/Line 2 puts it under Site. Empty = move its PLCs to the top level." />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Rename / move" Click="RenameFolder_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,0" />
                            <Button Content="＋  Add PLC here" Click="Add_Click" Style="{StaticResource SubtleButton}" />
                        </StackPanel>
                        <TextBlock Name="FolderStatus" Style="{StaticResource Hint}" Margin="2,10,0,0" />
                        <TextBlock Style="{StaticResource Hint}" Margin="2,18,0,0"
                                   Text="A folder exists while it holds PLCs. To create one, type its path in a PLC's Folder field." />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Name="StatusText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="2,0,220,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SubtleButton}" Margin="0,0,8,0" />
                <Button Content="Save list" Click="Save_Click" Style="{StaticResource AccentButton}" MinWidth="100" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
