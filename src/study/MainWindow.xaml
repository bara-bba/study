<Window x:Class="Study.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Study"
        Title="study — PLC tag monitor"
        Height="640" Width="980" MinHeight="420" MinWidth="760"
        Background="{StaticResource Brush.App}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <local:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:TextToVisibilityConverter x:Key="TextToVis" />
        <local:TriggerModeToIconConverter x:Key="ModeIcon" />
    </Window.Resources>

    <Grid Margin="20,10,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar (draggable via WindowChrome caption) -->
        <Grid Grid.Row="0" Height="44">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 4 px top margin = 2 px down: centres the icon on the word's ink (ascender d to descender y). -->
                <Image Name="TitleIcon" Width="22" Height="22" Margin="0,4,10,0" />
                <TextBlock Text="study" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="PLC tag monitor  ·  read-only" Foreground="{StaticResource Brush.TextTertiary}"
                           FontSize="12" VerticalAlignment="Center" Margin="12,3,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="—" Click="Minimize_Click" Style="{StaticResource IconButton}"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" />
                <Button Content="✕" Click="Close_Click" Style="{StaticResource IconButton}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Hide to tray (monitoring keeps running)" />
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,8,0,14">
            <StackPanel Orientation="Horizontal">
                <Button Content="＋  Add watch" Click="AddWatch_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                        ToolTip="Monitor a new tag" />
                <Border Width="1" Background="{StaticResource Brush.Stroke}" Margin="2,2,10,2" />
                <Button Content="PLCs…" Click="Plcs_Click" Style="{StaticResource SubtleButton}" Margin="0,0,8,0"
                        ToolTip="PLC list: import from RSLinx or CSV, test connection, detect slot" />
                <Button Content="Logs…" Click="Logs_Click" Style="{StaticResource SubtleButton}" Margin="0,0,8,0"
                        ToolTip="Open the log viewer" />
                <Button Content="⚙" FontSize="17" Click="Settings_Click" Style="{StaticResource ToolIconButton}"
                        ToolTip="Settings: alarm sound, volume, log folder, accent colour" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Name="SummaryText" Foreground="{StaticResource Brush.TextTertiary}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Name="PauseButton" Click="Pause_Click" Style="{StaticResource SubtleButton}">
                    <!-- Drawn glyph (not the ⏸ character): font fallback put that one off-centre. -->
                    <StackPanel Orientation="Horizontal">
                        <Path Name="PauseGlyph" Width="9" Height="10" Stretch="Uniform" VerticalAlignment="Center"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M 0,0 H 3.5 V 12 H 0 Z M 6.5,0 H 10 V 12 H 6.5 Z" Margin="0,1,9,0" />
                        <TextBlock Name="PauseLabel" Text="Pause monitoring" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Alarm banner -->
        <Border Grid.Row="2" Name="AlarmBanner" Visibility="Collapsed" Background="{StaticResource Brush.Alarm}"
                CornerRadius="6" Padding="16,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔔" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Name="AlarmTitle" FontWeight="SemiBold" FontSize="14" Foreground="White" />
                    <TextBlock Name="AlarmDetail" FontSize="12" Foreground="#FFFFE0DD" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Content="Acknowledge all" Click="AckAll_Click" Style="{StaticResource AlarmButton}"
                        ToolTip="Stop the sound. Level alarms stay silent until their condition clears and returns." />
            </Grid>
        </Border>

        <!-- Watch list -->
        <Grid Grid.Row="3">
            <TextBlock Name="EmptyText" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}"
                       FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Visibility="Collapsed" MaxWidth="460">
                No watches yet.<LineBreak />
                1. Click <Bold>PLCs…</Bold> and import your PLC list (RSLinx or CSV).<LineBreak />
                2. Click <Bold>＋ Add watch</Bold>, pick a PLC, type the tag and choose the trigger.<LineBreak />
                3. Alarm sound and log folder are under <Bold>⚙</Bold> (settings).
            </TextBlock>

            <ListBox Name="WatchList" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource Brush.TextPrimary}"
                     ItemContainerStyle="{StaticResource PlainListItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" Padding="0,0,6,0">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="card" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Width="10" Height="10" Margin="0,6,14,0" VerticalAlignment="Top"
                                         Fill="{Binding StatusColorKey, Converter={StaticResource KeyToBrush}}"
                                         ToolTip="{Binding StatusText}" />

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                        <Border Margin="10,0,0,0" CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                                                Background="{StaticResource Brush.Alarm}"
                                                Visibility="{Binding AlarmBadge, Converter={StaticResource TextToVis}}">
                                            <TextBlock Text="{Binding AlarmBadge}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TagText}" Foreground="{StaticResource Brush.TextSecondary}"
                                               FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Image Source="{Binding Mode, Converter={StaticResource ModeIcon}}" Width="14" Height="14"
                                               Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ConditionText}" Foreground="{StaticResource Brush.TextTertiary}"
                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding StatusColorKey, Converter={StaticResource KeyToBrush}}">
                                        <Run Text="{Binding StatusText, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="—" Foreground="{StaticResource Brush.TextTertiary}" />
                                        <Run Text="{Binding Message, Mode=OneWay}" Foreground="{StaticResource Brush.TextTertiary}" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding ValueText}" FontSize="22" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" />
                                    <TextBlock Text="{Binding LastReadText}" FontSize="11" HorizontalAlignment="Right"
                                               Foreground="{StaticResource Brush.TextTertiary}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Acknowledge" Click="Ack_Click" Style="{StaticResource AlarmButton}" Margin="0,0,8,0"
                                            Visibility="{Binding IsRinging, Converter={StaticResource BoolToVis}}" />
                                    <CheckBox Content="On" IsChecked="{Binding IsEnabled, Mode=OneWay}" Click="Enabled_Click"
                                              Style="{StaticResource DarkCheckBox}" Margin="0,0,12,0"
                                              ToolTip="Enable / disable this watch" />
                                    <Button Content="✎" Click="Edit_Click" Style="{StaticResource ToolIconButton}" Margin="0,0,6,0"
                                            ToolTip="Edit watch" />
                                    <Button Content="🗑" FontSize="14" Click="Delete_Click" Style="{StaticResource ToolIconButton}" ToolTip="Delete watch" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <!-- Colour only, constant thickness, so the card content never shifts. -->
                            <DataTrigger Binding="{Binding IsRinging}" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Brush.Alarm}" />
                                <Setter TargetName="card" Property="Background" Value="#FF3A2422" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
